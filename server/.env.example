# Bizzrow server env
NODE_ENV=development
PORT=5000
# DB name stays "smartvyapaar" for backward compatibility with existing data
MONGO_URI=mongodb://127.0.0.1:27017/smartvyapaar
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- WhatsApp Cloud API (Meta) ---
# From https://developers.facebook.com → your app → WhatsApp → API setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# --- Email (SMTP) for password reset ---
# If left blank, forgot-password still works: the reset link is logged to the
# server console (and returned as devLink when NODE_ENV != production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bizzrow <no-reply@bizzrow.app>

# Used to build the password-reset link sent to users
CLIENT_ORIGIN=http://localhost:5173
